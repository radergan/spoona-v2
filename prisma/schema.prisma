// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String    @unique
  password      String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  accounts        Account[]
  sessions        Session[]
  recipes         Recipe[]
  recipeBooks     RecipeBook[]
  mealPlans       MealPlan[]
  savedMeals      SavedMeal[]
  shoppingLists   ShoppingList[]
  foodSelections  UserFoodSelection[]
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Recipe {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String?
  instructions String[]
  ingredients  RecipeIngredient[]
  cookTime     Int?     // in minutes
  prepTime     Int?     // in minutes
  servings     Int?
  tags         String[]
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  recipeBooks  RecipeBookRecipe[]
  mealPlanItems MealPlanItem[]
}

model RecipeIngredient {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  amount      String
  unit        String?
  instacartId String?
  
  recipeId    String @db.ObjectId
  recipe      Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model RecipeBook {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  recipes     RecipeBookRecipe[]
}

model RecipeBookRecipe {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  recipeBookId String     @db.ObjectId
  recipeId     String     @db.ObjectId
  addedAt      DateTime   @default(now())
  
  recipeBook   RecipeBook @relation(fields: [recipeBookId], references: [id], onDelete: Cascade)
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  
  @@unique([recipeBookId, recipeId])
}

model SavedMeal {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  description    String?
  type           String   @default("product-based") // "recipe", "product-based", "mixed"
  estimatedTotal Float?
  prepTime       String?
  items          MealItem[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  mealPlanItems MealPlanItem[]
}

model MealItem {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  brand              String?
  category           String?
  quantity           Float?
  unit               String?
  instacartSearchTerm String?
  upc                String?
  estimatedPrice     Float?
  
  savedMealId String    @db.ObjectId
  savedMeal   SavedMeal @relation(fields: [savedMealId], references: [id], onDelete: Cascade)
}

model MealPlan {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  weekStart DateTime // Start of the week (Monday)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  items     MealPlanItem[]
  
  @@unique([userId, weekStart])
}

model MealPlanItem {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  day      Int      // 0 = Monday, 6 = Sunday
  mealType String   // "breakfast", "lunch", "dinner"
  
  // Either a recipe or a saved meal
  recipeId    String?    @db.ObjectId
  savedMealId String?    @db.ObjectId
  
  mealPlanId  String     @db.ObjectId
  mealPlan    MealPlan   @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipe      Recipe?    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  savedMeal   SavedMeal? @relation(fields: [savedMealId], references: [id], onDelete: Cascade)
  
  @@unique([mealPlanId, day, mealType])
}

model ShoppingList {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  items     ShoppingListItem[]
}

model ShoppingListItem {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  quantity       String?
  category       String?
  checked        Boolean @default(false)
  instacartId    String?
  estimatedPrice Float?
  
  shoppingListId String       @db.ObjectId
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
}

// ===== PRODUCT CATALOG MODELS =====
// Comprehensive food database built from scraping + APIs

model Product {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  upc             String?  @unique
  name            String
  brand           String
  description     String?
  category        String   // "Dairy", "Produce", "Meat & Seafood"
  subcategory     String?  // "Greek Yogurt", "Organic Milk", "Chicken Breast"
  keywords        String[] // ["organic", "fat-free", "greek", "high-protein"]
  
  // Nutrition data
  nutrition       NutritionData?
  servingSizes    ServingSize[]
  
  // Media
  imageUrl        String?
  thumbnailUrl    String?
  
  // Source tracking
  productUrl      String
  source          String   // "walmart", "target", "kroger", "usda", "spoonacular"
  lastUpdated     DateTime @default(now())
  verified        Boolean  @default(false) // Human verified nutrition data
  searchPopularity Int     @default(0)    // Track user selections
  
  // Relations
  userSelections  UserFoodSelection[]
  pricing         ProductPricing[]
  
  @@index([category, subcategory])
  @@index([brand, name])
  @@index([keywords])
}

// Embedded nutrition data
type NutritionData {
  servingSize          String
  servingsPerContainer Int?
  calories             Float
  totalFat             Float?
  saturatedFat         Float?
  transFat             Float?
  cholesterol          Float?
  sodium               Float?
  totalCarbs           Float?
  dietaryFiber         Float?
  sugars               Float?
  addedSugars          Float?
  protein              Float?
  vitaminD             Float?
  calcium              Float?
  iron                 Float?
  potassium            Float?
}

// Embedded serving size data  
type ServingSize {
  name      String  // "1 cup (240ml)", "1 container (170g)"
  grams     Float?
  isDefault Boolean
}

// Track user food selections for personalization
model UserFoodSelection {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  productId   String   @db.ObjectId
  selectedAt  DateTime @default(now())
  context     String   // "meal-planning", "recipe-creation", "search"
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@index([userId, selectedAt])
  @@index([productId, selectedAt])
}

// Store location-specific pricing separately (if needed later)
model ProductPricing {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  productId   String   @db.ObjectId
  store       String   // "walmart", "target", "kroger"
  location    String   // ZIP code or store ID
  price       Float
  available   Boolean  @default(true)
  lastChecked DateTime @default(now())
  
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@index([productId, store, location])
  @@index([lastChecked])
}

// USDA FoodData Central integration
model USDAFood {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  fdcId           String   @unique // USDA FDC ID
  description     String
  dataType        String   // "Foundation", "SR Legacy", "Branded"
  category        String?
  nutrition       NutritionData?
  lastUpdated     DateTime @default(now())
  
  @@index([dataType, category])
}